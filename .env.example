# GEMINI_API_KEY: Inyectada en runtime para funciones IA opcionales
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL de la aplicación alojada
APP_URL="MY_APP_URL"

# PORT: Puerto del servidor backend Express (3000 por defecto)
PORT=3000

# NODE_ENV: Entorno de ejecución (development / production)
NODE_ENV=development

# JWT_SECRET: Clave secreta para la firma y verificación de tokens de autenticación
JWT_SECRET="quibdo_migrantes_sec_key_2026_super_secret"

# DATABASE_URL: Cadena de conexión para la base de datos PostgreSQL (opcional si usa Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quibdo_migrantes"

# SUPABASE (Requerido para persistencia en la nube):
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_KEY="tu-service-role-key"
SUPABASE_ANON_KEY="tu-anon-key"

